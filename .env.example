# Supabase project URL and server-only secret key (preferred)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Legacy key fallback if your project has not moved to secret keys:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Use a long, unique password for /admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
